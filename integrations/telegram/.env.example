# Server only. Prefer START_TELEGRAM.bat; never put private config in the repository.
VOLUME_TELEGRAM_TOKEN=
VOLUME_TELEGRAM_USERNAME=
VOLUME_SUPABASE_URL=http://127.0.0.1:55321
VOLUME_SUPABASE_ANON_KEY=
# Local polling needs no domain. Buttons to loopback work only on the host PC.
VOLUME_TELEGRAM_LOCAL_TEST=1
VOLUME_CUSTOMER_URL=http://127.0.0.1:3000
VOLUME_CONTROL_URL=http://127.0.0.1:3001
# Dedicated local transport login, created by setup. Never use a browser/service-role key.
VOLUME_TELEGRAM_DB_URL=
